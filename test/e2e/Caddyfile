# No api_key: the module default {env.IPSCANNER_API_KEY} applies.
{
	admin off
	auto_https off
	# First match wins: the untrusted listener before the catch-all.
	servers :18096 {
		trusted_proxies static 203.0.113.0/24
	}
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

(upstream) {
	reverse_proxy upstream:8080
}

:18091 {
	log {
		output stdout
		format json
	}
	log_append ipscanner_class {http.vars.ipscanner.class}
	log_append ipscanner_action {http.vars.ipscanner.action}
	ipscanner {
		api_url {$IPSCANNER_API_URL}
		timeout {$E2E_TIMEOUT}
		site_id {$SITE_ENFORCE}
		policy_ttl 3s
		debug
	}
	@flagged vars ipscanner.action flag
	request_header @flagged X-Flagged 1
	import upstream
}

:18092 {
	ipscanner {
		api_url {$IPSCANNER_API_URL}
		timeout {$E2E_TIMEOUT}
		mode enforce
		block_classes malicious_automation tor
	}
	import upstream
}

:18093 {
	ipscanner {
		api_url {$IPSCANNER_API_URL}
		timeout {$E2E_TIMEOUT}
	}
	import upstream
}

:18094 {
	ipscanner {
		api_url {$DEAD_API_URL}
		mode enforce
		block_classes tor
	}
	import upstream
}

:18095 {
	ipscanner {
		api_url {$SLOW_API_URL}
		mode enforce
		block_classes tor
		timeout 500ms
	}
	import upstream
}

# The peer is not a trusted proxy here: X-Forwarded-For is ignored.
:18096 {
	ipscanner {
		api_url {$IPSCANNER_API_URL}
		timeout {$E2E_TIMEOUT}
		site_id {$SITE_ENFORCE}
	}
	import upstream
}

